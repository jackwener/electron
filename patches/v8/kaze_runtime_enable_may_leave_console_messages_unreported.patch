+++ b/include/js_protocol.pdl
@@ -1515,6 +1515,16 @@ domain Runtime
   # When the reporting gets enabled the event will be sent immediately for each existing execution
   # context.
   command enable
+    parameters
+      # OpenBrowser extension: defaults to true for normal DevTools clients.
+      # False skips cached and live console argument serialization for this session.
+      # Execution contexts, evaluation and explicit bindings remain available.
+      experimental optional boolean reportConsoleMessages
+      # OpenBrowser extension: defaults to true for normal DevTools clients.
+      # False reports console/exception objects by type only, without inspecting
