 src/inspector/v8-console-message.h     |  9 +++--
 src/inspector/v8-runtime-agent-impl.cc | 44 ++++++++++++++++++---
 src/inspector/v8-runtime-agent-impl.h  |  7 +++-
 5 files changed, 99 insertions(+), 26 deletions(-)

