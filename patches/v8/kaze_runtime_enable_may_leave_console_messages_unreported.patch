+// Type checks do not call page getters, proxy traps, or Error stack formatters.
+// Do not create remote handles: automatic diagnostics must not retain an object
+// for subsequent implicit inspection by a frontend.
+std::unique_ptr<protocol::Runtime::RemoteObject> wrapConsoleValue(
+    V8InspectorSessionImpl* session, v8::Local<v8::Context> context,
+    v8::Local<v8::Value> value, bool generatePreview, bool serializeObjects) {
+  if (!serializeObjects && value->IsObject()) {
+    return protocol::Runtime::RemoteObject::create()
+        .setType(value->IsFunction()
+                     ? protocol::Runtime::RemoteObject::TypeEnum::Function
+                     : protocol::Runtime::RemoteObject::TypeEnum::Object)
+        .build();
+  }
+  return session->wrapObject(context, value, "console", generatePreview);
+}
+
